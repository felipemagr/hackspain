# Copy to .env and fill in. .env is git-ignored. Every variable is optional.

# local | docker | prod
XRAY_ENV=local
XRAY_LOG_LEVEL=INFO

# Host port for docker compose
XRAY_PORT=8000

# Raw dataset folder, defaults to data/raw
# XRAY_DATA_DIR=

# Folder of parquet files written by the pipeline and read by the API, defaults to data/serving
# XRAY_SERVING_DIR=

# Front end origins allowed by CORS, as a JSON list
XRAY_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Slack incoming webhook for monitor alerts: https://api.slack.com/messaging/webhooks
# Test it with: make slack-test
XRAY_SLACK_WEBHOOK_URL=

# SMTP for the monitor's email alerts. Without a host and a recipient, email is skipped.
# Test it with: make email-test
XRAY_SMTP_HOST=
# XRAY_SMTP_PORT=587
XRAY_SMTP_USER=
XRAY_SMTP_PASSWORD=
XRAY_ALERT_EMAIL_FROM=xray@localhost
XRAY_ALERT_EMAIL_TO=

# Tavily web search used by the context retrieval agent: https://tavily.com
TAVILY_API_KEY=

# Exa semantic search used by the peers agent: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Helmcode managed inference, OpenAI-compatible: https://helmcode.com/docs/integrations
# Without a key the agents return raw search hits instead of a read summary.
HELMCODE_API_KEY=
# XRAY_LLM_MODEL=glm5.3

# Days a company's retrieved context stays valid in data/serving/context
# XRAY_CONTEXT_TTL_DAYS=7

# Shared key in front of /api/v1, sent by the web as X-API-Key. Empty: the API is open (local work).
# Generate one with: openssl rand -hex 32. The web reads the same value from VITE_API_KEY (web/.env.local).
LIGHTHOUSE_API_KEY=
