# Copy to .env and fill in. .env is git-ignored. Every variable is optional.

# local | docker | prod
XRAY_ENV=local
XRAY_LOG_LEVEL=INFO

# Host port for docker compose
XRAY_PORT=8000

# Raw dataset folder, defaults to data/raw
# XRAY_DATA_DIR=

# Folder of parquet files written by the pipeline and read by the API, defaults to data/serving
# XRAY_SERVING_DIR=

# Front end origins allowed by CORS, as a JSON list
XRAY_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Slack incoming webhook for monitor alerts: https://api.slack.com/messaging/webhooks
# Test it with: make slack-test
XRAY_SLACK_WEBHOOK_URL=

# Tavily web search used by the company research agent: https://tavily.com
XRAY_TAVILY_API_KEY=
