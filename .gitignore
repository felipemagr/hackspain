# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# Secrets
.env
.env.*
!.env.example

# Data: the dataset stays out of git, only the folders are tracked
data/*.zip
data/raw/*
data/processed/*
data/marts/*
data/lake/*
data/serving/*
# Serving tables are a few hundred KB and everyone builds the product against the same ones
!data/serving/*.parquet
# Cached agent context: the deployed API has no other way to get it
!data/serving/context/
!data/serving/context/*.json
!data/**/.gitkeep
output/

# Web demo
web/node_modules/
web/dist/

# Impeccable working files
.impeccable/

# Local
.DS_Store
.claude/settings.local.json
